[Unit]
Description=VRChat Auto-Diary Service
After=network-online.target
Wants=network-online.target
OnFailure=vlog-monitor-failure.service
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=notify
NotifyAccess=main
WatchdogSec=120s
TimeoutStartSec=30s
TimeoutStopSec=60s
WorkingDirectory=@VLOG_ROOT@
EnvironmentFile=-@VLOG_ROOT@/.env
Environment=PYTHONPATH=@VLOG_PYTHONPATH@
Environment=PYTHONUNBUFFERED=1
Environment=VLOG_SERVICE_NAME=vlog-monitor
ExecStart=@VLOG_UV@ run python -m src.main
Restart=on-failure
RestartSec=10s
UMask=0077

NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
ReadWritePaths=@VLOG_ROOT@/data
ReadOnlyPaths=@VLOG_ROOT@/apps/capture-vrchat @VLOG_ROOT@/packages @VLOG_ROOT@/pyproject.toml @VLOG_ROOT@/uv.lock

[Install]
WantedBy=default.target
