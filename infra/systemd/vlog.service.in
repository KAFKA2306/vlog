[Unit]
Description=VRChat Auto-Diary Service
After=network-online.target
Wants=network-online.target
OnFailure=vlog-monitor-failure.service
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=notify
NotifyAccess=main
WatchdogSec=120s
TimeoutStartSec=30s
TimeoutStopSec=60s
WorkingDirectory=@VLOG_ROOT@
@VLOG_ENV_FILE_DIRECTIVE@
Environment=PYTHONUNBUFFERED=1
Environment=VLOG_PROJECT_ROOT=@VLOG_ROOT@
Environment=VLOG_CONFIG_HOME=@VLOG_CONFIG_HOME@
Environment=VLOG_DATA_HOME=@VLOG_DATA_HOME@
Environment=VLOG_STATE_HOME=@VLOG_STATE_HOME@
Environment=VLOG_CACHE_HOME=@VLOG_CACHE_HOME@
Environment=VLOG_SERVICE_NAME=vlog-monitor
ExecStart=@VLOG_UV@ run --frozen vlog-service
Restart=on-failure
RestartSec=10s
UMask=0077

NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
ReadWritePaths=-@VLOG_CONFIG_HOME@ -@VLOG_DATA_HOME@ -@VLOG_STATE_HOME@ -@VLOG_CACHE_HOME@
ReadOnlyPaths=@VLOG_ROOT@

[Install]
WantedBy=default.target
