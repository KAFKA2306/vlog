[Unit]
Description=VRChat Vlog Daily Processing
OnFailure=vlog-daily-failure.service
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=@VLOG_ROOT@
@VLOG_ENV_FILE_DIRECTIVE@
Environment=VLOG_PROJECT_ROOT=@VLOG_ROOT@
Environment=VLOG_CONFIG_HOME=@VLOG_CONFIG_HOME@
Environment=VLOG_DATA_HOME=@VLOG_DATA_HOME@
Environment=VLOG_STATE_HOME=@VLOG_STATE_HOME@
Environment=VLOG_CACHE_HOME=@VLOG_CACHE_HOME@
ExecStart=@VLOG_UV@ run --frozen vlog-daily
Environment="PATH=/snap/bin:%h/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"

NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=-@VLOG_CONFIG_HOME@ -@VLOG_DATA_HOME@ -@VLOG_STATE_HOME@ -@VLOG_CACHE_HOME@
ReadOnlyPaths=@VLOG_ROOT@

[Install]
WantedBy=default.target
