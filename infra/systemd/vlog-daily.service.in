[Unit]
Description=VRChat Vlog Daily Processing
OnFailure=vlog-daily-failure.service
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=@VLOG_ROOT@
EnvironmentFile=@VLOG_ROOT@/.env
ExecStart=@VLOG_UV@ run vlog-daily
Environment="PATH=/snap/bin:%h/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"

NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=@VLOG_ROOT@/data
ReadOnlyPaths=@VLOG_ROOT@/apps/capture-vrchat @VLOG_ROOT@/packages @VLOG_ROOT@/pyproject.toml @VLOG_ROOT@/uv.lock

[Install]
WantedBy=default.target
